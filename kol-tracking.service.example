[Unit]
Description=KOL tracking Telegram bot (reads the automated_signals PumpAPI relay)
After=network-online.target automated-signals.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kol_tracking
EnvironmentFile=/root/kol_tracking/.env
ExecStart=/root/kol_tracking/venv/bin/python -u -m kolbot.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
